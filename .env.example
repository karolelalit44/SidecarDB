# sidecarDB — every settable key of the Settings model.
# Behaviour is fixed in code, not in the environment: the knobs live in
# src/core/constants.py and are deliberately not settable here.
#
# Only the first two keys are mandatory; everything else has a default.

# --- The two mandatory values -------------------------------------------

DATABASE_URL=postgresql://reader@localhost:5432/sales
LLM_API_KEY=sk-...

# --- Database -------------------------------------------------------------

# The one schema to introspect and to restrict every statement to.
DB_SCHEMA=public

# For any remote database, prefer "require" (or stronger).
DB_SSL=

# --- Model provider ---------------------------------------------------------

# The planner endpoint and model that questions and schema summaries go to.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Provider-specific additions merged into every planner request, as JSON
# (e.g. {"region": "eu-1"}). Leave empty for none.
LLM_EXTRA_BODY=

# --- Embeddings --------------------------------------------------------------

# "api" for a hosted embedding endpoint (default), "local" for a
# sentence-transformers model (pip install 'sidecardb[embeddings]'),
# or "none" to fall back to catalog order.
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=text-embedding-3-small

# A distinct base URL and key for the embedding endpoint; empty inherits
# LLM_BASE_URL and LLM_API_KEY.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_LOCAL_PATH=
EMBEDDING_DEVICE=cpu

# --- HTTP service -------------------------------------------------------------

# Comma-separated API keys. Requests without a valid key are rejected when
# at least one key is set.
API_KEYS=
