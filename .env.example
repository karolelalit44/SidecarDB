# askdb configuration.
#
# Only DATABASE_URL and LLM_API_KEY are required. Every other key below is
# shown with the value it takes when the key is absent, so copy this file,
# fill in the two credentials, and you are running.

APP_NAME=askdb

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DEPENDENCY_LEVEL=WARNING
LOG_SQL=false

# Writes the raw model reply, its reasoning scratchpad and transport stack
# traces to the log. Off by default: the payload reaches the model provider and
# a stack trace is noise unless something is already wrong.
LOG_LLM_PAYLOADS=false

# "text" or "json" (one object per line, for log aggregation).
LOG_FORMAT=text

# "auto" colours only when stdout is a terminal; "on"/"off" force it.
LOG_COLOR=auto

# --- HTTP service ----------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Comma-separated API keys accepted on /api/v1/*. Empty means no
# authentication and a loud startup warning. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60.0
MAX_REQUEST_BODY_BYTES=65536

# Browser origins allowed to call the API. Empty disables CORS entirely
# (correct for server-to-server callers).
CORS_ALLOW_ORIGINS=
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-API-Key,X-Request-ID
CORS_ALLOW_CREDENTIALS=false

# --- database (required) ---------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/database
DB_SCHEMA=public

# Passed straight to asyncpg. Empty defers to the default; other valid values
# are disable, require, verify-ca, verify-full.
DB_SSL=

POOL_MIN_SIZE=1
POOL_MAX_SIZE=8
DB_CONNECT_RETRIES=3
DB_CONNECT_BACKOFF_SECONDS=0.5
DB_MAX_INACTIVE_CONNECTION_LIFETIME=300.0
INTROSPECTION_TIMEOUT_SECONDS=15.0

# --- execution sandbox -----------------------------------------------------
SANDBOX_STATEMENT_TIMEOUT_SECONDS=5.0
SANDBOX_APP_TIMEOUT_SECONDS=15.0
SANDBOX_IDLE_TIMEOUT_MS=10000
SANDBOX_MAX_ROWS=5000
SANDBOX_TRANSACTION_READ_ONLY=true

# --- planning --------------------------------------------------------------
MIN_QUERY_LENGTH=2
MAX_QUERY_LENGTH=250
DEFAULT_LIMIT=25
MAX_LIMIT=200
MAX_PLAN_ATTEMPTS=3

# Characters of rejection detail fed back to the model for repair. It lists the
# valid column and operator names, so it is trimmed to keep the prompt inside
# the context window.
REPAIR_CHAR_BUDGET=800
MAX_SCHEMA_TABLES=30
MAX_SCHEMA_COLUMNS=120

# --- language model (required key; the rest are defaults) ------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Temperature used when a plan is rejected and retried. At LLM_TEMPERATURE the
# model reproduces the rejected reply verbatim, so a repair could never differ
# and every retry would cost full model latency to reach the same failure.
LLM_REPAIR_TEMPERATURE=0.6

LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120.0
LLM_RETRIES=2

# Provider-specific request options, merged into every chat completion, as a
# JSON object. A reasoning model bills its scratchpad against LLM_MAX_TOKENS, so
# a small budget is spent before any answer is produced and the reply arrives
# empty. Set {"chat_template_kwargs": {"enable_thinking": false}} to turn it off.
# The empty object is correct for a provider that needs nothing.
LLM_EXTRA_BODY={}

# Context window of the configured model. Prompts are trimmed to fit.
LLM_CONTEXT_TOKENS=8192

# Characters per token for the configured model, used to size prompts.
# Err high: overcounting truncates, undercounting gets the request rejected.
LLM_CHARS_PER_TOKEN=4

# --- embeddings ------------------------------------------------------------
# "api" calls an OpenAI-compatible /embeddings endpoint (no heavy dependencies);
# "local" runs sentence-transformers in-process (pip install 'askdb[embeddings]');
# "none" turns retrieval off and plans from catalog order.
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=text-embedding-3-small

# Empty means "reuse LLM_BASE_URL / LLM_API_KEY".
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# A local copy of the model directory (local provider only). Leave empty to
# fetch it from the Hugging Face Hub on first use; point this at a directory to
# run with no network.
EMBEDDING_LOCAL_PATH=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=12
RETRIEVAL_MIN_SCORE=0.15
RETRIEVAL_SCORE_PRECISION=6

# --- behaviour -------------------------------------------------------------
ERROR_MESSAGE_MAX_CHARS=200
REDACT_CATALOG_IN_ERRORS=true

# Off by default: returning generated SQL to callers discloses table names and
# query shape.
EXPOSE_SQL=false

ELAPSED_PRECISION=2

NO_RECORDS_MESSAGE=No matching records were found.
NO_SUMMARY_MESSAGE=The query returned records but no summary could be produced.

# --- resilience ------------------------------------------------------------
# /health caches its database ping for this long, so probes cannot stampede.
HEALTH_PING_CACHE_SECONDS=2.0

# Interval between database recovery attempts while degraded.
RECOVERY_INTERVAL_SECONDS=15.0
