# ==============================================================================
# Environment Configuration — Generic NL-to-SQL Search Engine
# ==============================================================================

# Application & API
APP_NAME="Generic NL-to-SQL Search Engine"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL="INFO"

# Database Configuration (Host port mapped to 5435 in docker-compose)
DB_HOST="localhost"
DB_PORT=5435
DB_NAME="investigation_db"
DB_USER="nl_search_user"
DB_PASSWORD="nl_search_pass_secret"
DB_ADMIN_USER="postgres"
DB_ADMIN_PASSWORD="postgres_master_secret"
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_QUERY_TIMEOUT_SECONDS=3.0

# LLM Configuration (Dual Mode)
# LLM_ENABLED=false uses deterministic rule/pattern engine (zero-cost offline mode)
# LLM_ENABLED=true connects to any OpenAI-compatible provider (OpenAI, Ollama, Groq, etc.)
LLM_ENABLED=false
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Security & AST Guardrails
MAX_QUERY_LIMIT=50
DEFAULT_QUERY_LIMIT=25
ENABLE_PII_MASKING=true
