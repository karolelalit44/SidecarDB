# sidecarDB configuration.
#
# The environment carries only what legitimately varies per deployment:
# which database to read, which model provider to call, and the secrets.
# Every other knob (timeouts, limits, logging, service defaults) is fixed
# inside the package in sidecardb/core/constants.py.

# --- database (required) ---------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/database
DB_SCHEMA=public

# Passed straight to asyncpg. Empty defers to the default; other valid values
# are disable, require, verify-ca, verify-full.
DB_SSL=

# --- language model (required key; the rest are defaults) ------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Provider-specific request options, merged into every chat completion, as a
# JSON object. A reasoning model bills its scratchpad against the completion
# budget, so a small budget is spent before any answer is produced and the
# reply arrives empty. Set {"chat_template_kwargs": {"enable_thinking": false}}
# to turn it off. The empty object is correct for a provider that needs nothing.
LLM_EXTRA_BODY={}

# --- embeddings ------------------------------------------------------------
# "api" calls an OpenAI-compatible /embeddings endpoint (no heavy dependencies);
# "local" runs sentence-transformers in-process (pip install 'sidecardb[embeddings]');
# "none" turns retrieval off and plans from catalog order.
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=text-embedding-3-small

# Empty means "reuse LLM_BASE_URL / LLM_API_KEY".
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# A local copy of the model directory (local provider only). Leave empty to
# fetch it from the Hugging Face Hub on first use; point this at a directory to
# run with no network.
EMBEDDING_LOCAL_PATH=
EMBEDDING_DEVICE=cpu

# --- secrets ---------------------------------------------------------------
# Comma-separated API keys accepted on /api/v1/*. Empty means no authentication
# and a loud startup warning. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- docker compose only (not read by the app process) ---------------------
DB_NAME=sidecardb_demo
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
DB_USER=nl_search_user
DB_PASSWORD=
DB_PORT=5435
APP_PORT=8000
